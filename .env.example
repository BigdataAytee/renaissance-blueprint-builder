# Copy to .env and fill in from your Supabase project settings.
# Lovable Cloud injects these automatically for hosted builds.
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Required by the admin user-management server functions.
# Never expose this to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Used by the notify-contact edge function to email contact-form
# submissions; without it the function logs and skips sending.
RESEND_API_KEY=
CONTACT_NOTIFICATION_TO=
CONTACT_NOTIFICATION_FROM=
