# Copy to .env and fill in from your Supabase project settings.
# Lovable Cloud injects these automatically for hosted builds.
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Required by the admin user-management server functions.
# Never expose this to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Emails contact-form submissions via Resend. Without it the
# submission is still stored and the send is skipped with a warning.
# CONTACT_NOTIFICATION_FROM must be a domain verified in Resend — the default
# onboarding@resend.dev only delivers to the address owning the Resend account.
RESEND_API_KEY=
CONTACT_NOTIFICATION_TO=
CONTACT_NOTIFICATION_FROM=

# Cloudflare Turnstile.
#
# Set BOTH or NEITHER. With neither, the widget does not render and the server
# skips verification — the forms keep working on the per-IP throttle alone.
# Setting only TURNSTILE_SECRET_KEY refuses every submission, because the
# browser never renders a challenge to solve and the server then rejects the
# missing token.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Server-only. Any long random string. Peppers the SHA-256 of visitor IPs in
# the throttle ledger so the stored digests cannot be brute-forced back to an
# address. Changing it resets everyone's throttle counters.
THROTTLE_IP_PEPPER=
